#version 450 core
#extension GL_EXT_samplerless_texture_functions : require

// Copies the depth aspect of a depth image into a 32-bit color image, bit for bit.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform texture2D depth;
layout(binding = 1, r32ui) uniform writeonly uimage2D color;

void main() {
	const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(coord, imageSize(color)))) {
		return;
	}
	imageStore(color, coord, uvec4(floatBitsToUint(texelFetch(depth, coord, 0).r)));
}
