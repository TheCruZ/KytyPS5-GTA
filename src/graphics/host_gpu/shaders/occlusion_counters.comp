#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// The guest's occlusion counters on the GPU timeline (see OcclusionQueries::WriteForReaders()):
// the running sample total after each dump of the command buffer, from the host query results the
// command buffer copied, written as the dumps write them into the copies of guest memory that the
// next operation reads.

layout(local_size_x = 256) in;

// A dump: the host query slots of the segment it ends, and whether some of its samples had none.
struct Dump {
	uint first_slot;
	uint slot_count;
	uint uncounted;
	uint pad;
};

// One dump's counters in a copy of guest memory: its DBs [db_first, db_end) at address + db * 16.
// The total is the one of dump `dump`, or `known` (a dump published already) when dump is ~0.
struct Write {
	uint64_t address;
	uint64_t known;
	uint     dump;
	uint     db_first;
	uint     db_end;
	uint     pad;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Dumps {
	Dump v[];
};
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Writes {
	Write v[];
};
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Results {
	uint64_t v[];
};
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Totals {
	uint64_t v[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Dword {
	uint v;
};

layout(push_constant, std430) uniform Push {
	uint64_t dumps;
	uint64_t writes;
	uint64_t results;
	uint64_t totals;
	uint64_t base;
	uint     dump_count;
	uint     write_count;
	uint     capacity;
	uint     pad;
} pc;

const uint64_t ReadyBit         = 1ul << 63;
const uint64_t ValueMask        = ReadyBit - 1ul;
const uint64_t UncountedSamples = 1ul << 24;

shared uint64_t partial[256];

uint64_t Samples(uint index) {
	const Dump dump    = Dumps(pc.dumps).v[index];
	uint64_t   samples = dump.uncounted != 0u ? UncountedSamples : 0ul;
	for (uint i = 0u; i < dump.slot_count; i++) {
		samples += Results(pc.results).v[(dump.first_slot + i) % pc.capacity];
	}
	return samples;
}

void Store(uint64_t address, uint64_t value) {
	// Two dwords: a copy of guest memory needs no more than dword alignment.
	Dword(address).v      = uint(value);
	Dword(address + 4ul).v = uint(value >> 32);
}

void main() {
	const uint thread = gl_LocalInvocationID.x;
	const uint per    = (pc.dump_count + 255u) / 256u;
	const uint first  = min(thread * per, pc.dump_count);
	const uint end    = min(first + per, pc.dump_count);
	uint64_t   sum    = 0ul;
	for (uint i = first; i < end; i++) {
		sum += Samples(i);
	}
	partial[thread] = sum;
	barrier();
	if (thread == 0u) {
		uint64_t running = pc.base;
		for (uint i = 0u; i < 256u; i++) {
			const uint64_t part = partial[i];
			partial[i]          = running;
			running += part;
		}
	}
	barrier();
	uint64_t running = partial[thread];
	for (uint i = first; i < end; i++) {
		running += Samples(i);
		Totals(pc.totals).v[i] = running;
	}
	memoryBarrierBuffer();
	barrier();
	for (uint i = thread; i < pc.write_count; i += 256u) {
		const Write    write = Writes(pc.writes).v[i];
		const uint64_t total = write.dump == ~0u ? write.known : Totals(pc.totals).v[write.dump];
		for (uint db = write.db_first; db < write.db_end; db++) {
			Store(write.address + uint64_t(db) * 16ul, db == 0u ? (ReadyBit | (total & ValueMask)) : ReadyBit);
		}
	}
}
