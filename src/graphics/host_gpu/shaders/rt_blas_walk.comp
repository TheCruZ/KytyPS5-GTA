#version 460
#extension GL_GOOGLE_include_directive : require
// Native ray tracing: walks one guest bottom-level AMD BVH per workgroup (GTA V layout: box nodes
// whose leaves are lists of 8-byte entries in the BLAS buffer: an AMD triangle node pointer and a
// primitive word, bit 31 = last entry, bit 30 = opaque).
// MODE_COUNT: counts box nodes, leaves and triangles (opaque, alpha tested) of the BLASes the
//             top-level walk found missing.
// MODE_BUILD: writes the triangles (opaque ones as geometry 0, alpha tested ones as geometry 1)
//             with their entry table, and pads both geometries with inactive (NaN) triangles.
// MODE_VERIFY: recomputes the signature of the boxes of built slots and lists those that changed.
//
// A build with a layout (a BLAS whose build the host saw, see NativeRayTracing::NoteGuestBlasBuilds())
// places each triangle by its primitive: the geometry of its triangle node (the header's table of
// the geometry of each triangle node: +40 offset, +108 geometry count, +124 first triangle node)
// and the triangle index of its primitive word (bits 0-29), at the geometry's first host
// primitive plus that index, in the host geometry of the guest geometry's opacity. Positions no
// list entry names keep the inactive triangle the host filled them with, and a triangle named by
// several leaves (split) is written once per leaf with the same values. An entry that does not
// match the layout (no geometry, an index past the geometry's triangles, an opacity other than the
// geometry's) is counted and fails the build. So does memory that no longer holds the BLAS the
// layout describes (a header without the magic and version 9, or with another geometry count:
// released and reused, or rebuilt since), without placing anything. The host gives up such slots.

#include "rt_common.inc"

layout(local_size_x = 256) in;

// A build job (written by the host).
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Job {
	uint64_t blas_va;
	uint     root;
	uint     slot;
	uint64_t vertices0;
	uint64_t vertices1;
	uint64_t entries;
	uint     capacity0;
	uint     capacity1;
	uint     result;
	uint     pad;
	// The layout of the build (0: none) and its geometries, then (written back) the entries that
	// did not match it.
	uint64_t layout_va;
	uint     layout_count;
	uint     mismatches;
};

// The layout of one guest geometry (written by the host): its first host primitive, its triangle
// count and whether it is opaque.
layout(buffer_reference, std430, buffer_reference_align = 16) buffer LayoutRef {
	uvec4 v;
};

layout(buffer_reference, std430, buffer_reference_align = 4) buffer TriangleRef {
	float v[9];
};

layout(buffer_reference, std430, buffer_reference_align = 16) buffer EntryRef {
	uvec4 v;
};

layout(push_constant, std430) uniform Push {
	uint64_t jobs;
	uint64_t pool;
	uint64_t slots;
	uint64_t state;
	uint64_t changed;
	uint     mode;
	uint     pool_capacity;
	uint     job_count;
	uint     changed_capacity;
} pc;

const uint MODE_COUNT  = 0u;
const uint MODE_BUILD  = 1u;
const uint MODE_VERIFY = 2u;
// MODE_GATHER: rewrites the triangles of built slots whose guest BLAS was only refit since,
//              through their entry tables (same triangles, same order).
const uint MODE_GATHER = 3u;

// The queue of a walk of a BLAS of known leaves: its box nodes (a 4 wide tree has about a third
// of the leaves, a chain of boxes as many as there are leaves) and some room for growth; a walk
// that needs more reports an overflow and the host builds the BLAS again with the node limit of
// its header (0 leaves: not known, the node limit is used at once).
uint QueueNodes(uint leaf_count) {
	return leaf_count == 0 ? 0u : leaf_count + leaf_count / 2 + 64;
}

const uint kJobStride = 72;
const uint kMaxQueue  = 1u << 20;

shared uint s_head;
shared uint s_tail;
shared uint s_next_tail;
shared uint s_leaves;
shared uint s_opaque;
shared uint s_alpha;
shared uint s_signature;
shared uint s_overflow;
shared uint s_queue_base;
shared uint s_queue_size;
shared uint s_capacity0;
shared uint s_capacity1;
// Layout builds: the guest geometries (the header's), the table of the geometry of each triangle
// node and the first triangle node, and the entries that did not match.
shared uint     s_layout_geometries;
shared uint64_t s_node_geometries;
shared uint     s_node_first;
shared uint     s_mismatches;
// A layout build of memory that does not hold a BVH (not written yet, or released and reused).
shared uint     s_layout_invalid;
// The box of the whole BLAS (lo > hi: unknown).
shared vec3 s_root_lo;
shared vec3 s_root_hi;

// The host position of a list entry of a layout build (see the top), or kInvalidNode when it
// does not match the layout.
uint LayoutPosition(Job job, uint tri, uint word, bool opaque) {
	if (NodeType(tri) > 3u || (tri >> 3) < s_node_first) {
		return kInvalidNode;
	}
	// The geometry of the triangle node (the game's own leaf code looks it up the same way).
	const uint lo = LoadGuestU32(s_node_geometries + uint64_t((tri >> 3) - s_node_first) * 4);
	if (lo >= s_layout_geometries) {
		return kInvalidNode;
	}
	const uvec4 geometry = LayoutRef(job.layout_va + uint64_t(lo) * 16).v;
	const uint  triangle = word & 0x3fffffffu;
	if (triangle >= geometry.y || (geometry.z != 0u) != opaque) {
		return kInvalidNode;
	}
	return geometry.x + triangle;
}

// Counts (and in MODE_BUILD writes) the triangles of a guest leaf list.
// `lo`/`hi`: the box of the leaf in its parent node (lo > hi: unknown, for a root leaf).
void EmitLeaf(uint64_t blas_va, uint64_t base, uint leaf, Job job, vec3 lo, vec3 hi) {
	atomicAdd(s_leaves, 1u);
	const uint first = leaf >> 3;
	for (uint k = 0; k < kMaxLeafEntries; k++) {
		const uint64_t entry  = blas_va + (uint64_t(first + k) << 3);
		const uint     tri    = LoadGuestU32(entry);
		const uint     word   = LoadGuestU32(entry + 4);
		const bool     opaque = ((word >> 30) & 1u) != 0;
		uint           index  = opaque ? atomicAdd(s_opaque, 1u) : atomicAdd(s_alpha, 1u);
		if (pc.mode == MODE_BUILD && job.layout_va != 0) {
			// Nothing to place from memory that holds another BLAS: the positions stay inactive.
			if (s_layout_invalid != 0) {
				return;
			}
			index = LayoutPosition(job, tri, word, opaque);
			if (index == kInvalidNode) {
				atomicAdd(s_mismatches, 1u);
			}
		}
		if (pc.mode == MODE_BUILD) {
			const uint capacity = opaque ? s_capacity0 : s_capacity1;
			if (index < capacity) {
				const uint64_t node = NodeAddress(base, tri);
				const uvec3    ids  = TriangleVertexIds(NodeType(tri));
				TriangleRef out_triangle =
				    TriangleRef((opaque ? job.vertices0 : job.vertices1) + uint64_t(index) * 36);
				// A vertex the hardware cannot take (non-finite or absurdly far, as in a node the
				// guest is rewriting) makes the triangle inactive (NaN) instead of undefined.
				bool usable = true;
				for (uint v = 0; v < 3; v++) {
					const vec3 p = LoadVertex(node, ids[v]);
					usable = usable && !any(isnan(p)) && all(lessThan(abs(p), vec3(1e18)));
				}
				// A triangle outside its box is from a node the guest was writing. Of a BLAS the game
				// refits (job.pad 1: vehicles, peds) the box is the leaf's, which keeps the triangles
				// of half written nodes out; of the others (buildings) it is the box of the whole
				// BLAS, because the boxes of the leaves of those leave out triangles of their lists
				// (dropping them left the sun lighting the inside of a garage).
				const bool leaf_box = job.pad != 0;
				const vec3 box_lo   = leaf_box ? lo : s_root_lo;
				const vec3 box_hi   = leaf_box ? hi : s_root_hi;
				if (all(lessThanEqual(box_lo, box_hi))) {
					const vec3 margin = (box_hi - box_lo) * 1e-3 + vec3(1e-3);
					for (uint v = 0; v < 3; v++) {
						const vec3 p = LoadVertex(node, ids[v]);
						usable = usable && all(greaterThanEqual(p, box_lo - margin)) &&
						         all(lessThanEqual(p, box_hi + margin));
					}
				}
				for (uint v = 0; v < 3; v++) {
					const vec3 p = usable ? LoadVertex(node, ids[v]) : vec3(uintBitsToFloat(0x7fc00000u));
					out_triangle.v[v * 3]     = p.x;
					out_triangle.v[v * 3 + 1] = p.y;
					out_triangle.v[v * 3 + 2] = p.z;
				}
				const uint table_index = opaque ? index : s_capacity0 + index;
				// The barycentric remap of the triangle (node word 15, 8 bits per triangle type).
				const uint remap = (LoadGuestU32(node + 60) >> (NodeType(tri) * 8u)) & 0xffu;
				EntryRef(job.entries + uint64_t(table_index) * 16).v =
				    uvec4((first + k) << 3, word, tri, remap);
			}
		}
		if ((word & 0x80000000u) != 0) {
			break;
		}
	}
}

// MODE_GATHER: triangle `index` of geometry `geometry` (0 opaque, 1 alpha tested) of a job.
void GatherTriangle(Job job, uint64_t base, uint index, uint geometry) {
	const uint     table_index  = geometry == 0u ? index : job.capacity0 + index;
	const uvec4    entry        = EntryRef(job.entries + uint64_t(table_index) * 16).v;
	const uint     tri          = entry.z;
	const uint64_t node         = NodeAddress(base, tri);
	const uvec3    ids          = TriangleVertexIds(NodeType(tri));
	TriangleRef    out_triangle = TriangleRef((geometry == 0u ? job.vertices0 : job.vertices1) + uint64_t(index) * 36);
	vec3 p[3];
	// A position of a layout build that no list entry named stays inactive.
	bool usable = entry.x != kInvalidNode;
	for (uint v = 0; v < 3; v++) {
		p[v]   = usable ? LoadVertex(node, ids[v]) : vec3(0.0);
		usable = usable && !any(isnan(p[v])) && all(lessThan(abs(p[v]), vec3(1e18)));
	}
	for (uint v = 0; v < 3; v++) {
		const vec3 q = usable ? p[v] : vec3(uintBitsToFloat(0x7fc00000u));
		out_triangle.v[v * 3]     = q.x;
		out_triangle.v[v * 3 + 1] = q.y;
		out_triangle.v[v * 3 + 2] = q.z;
	}
}

void main() {
	const uint job_index  = gl_WorkGroupID.x;
	const uint lid        = gl_LocalInvocationID.x;
	if (pc.mode == MODE_GATHER) {
		if (job_index >= pc.job_count) {
			return;
		}
		Job            job    = Job(pc.jobs + uint64_t(job_index) * kJobStride);
		SlotInfo       info   = SlotInfo(pc.slots + uint64_t(job.slot) * kSlotStride);
		const uint64_t base   = (job.blas_va >> 8) << 8;
		const uint     count0 = min(info.count0, job.capacity0);
		const uint     count1 = min(info.count1, job.capacity1);
		for (uint i = lid; i < count0 + count1; i += gl_WorkGroupSize.x) {
			if (i < count0) {
				GatherTriangle(job, base, i, 0u);
			} else {
				GatherTriangle(job, base, i - count0, 1u);
			}
		}
		return;
	}
	RtState    state      = RtState(pc.state);
	uint64_t   blas_va    = 0;
	uint       root       = kInvalidNode;
	uint       slot       = 0;
	uint       queue_size = 0;
	Job        job        = Job(pc.jobs + uint64_t(job_index) * kJobStride);
	if (pc.mode == MODE_COUNT) {
		MissingEntry missing = MissingEntry(pc.jobs + uint64_t(job_index) * kMissingStride);
		blas_va = missing.blas_va;
		root    = missing.root;
	} else if (pc.mode == MODE_BUILD) {
		if (job_index >= pc.job_count) {
			return;
		}
		blas_va       = job.blas_va;
		root          = job.root;
		slot          = job.slot;
		SlotInfo info = SlotInfo(pc.slots + uint64_t(slot) * kSlotStride);
		queue_size    = QueueNodes(info.leaf_count);
	} else {
		slot          = U32Ref(pc.jobs + uint64_t(job_index) * 4).v;
		SlotInfo info = SlotInfo(pc.slots + uint64_t(slot) * kSlotStride);
		blas_va       = info.blas_va;
		root          = info.root;
		queue_size    = QueueNodes(info.leaf_count);
	}
	const uint64_t base = (blas_va >> 8) << 8;
	if (lid == 0) {
		s_head      = 0;
		s_tail      = 0;
		s_leaves    = 0;
		s_opaque    = 0;
		s_alpha     = 0;
		s_signature = 0;
		s_overflow  = 0;
		s_capacity0 = pc.mode == MODE_BUILD ? job.capacity0 : 0;
		s_capacity1 = pc.mode == MODE_BUILD ? job.capacity1 : 0;
		s_root_lo   = vec3(1e30);
		s_root_hi   = vec3(-1e30);
		s_mismatches        = 0;
		s_layout_geometries = 0;
		s_layout_invalid    = 0;
		s_node_first        = 0;
		s_node_geometries   = 0;
		if (pc.mode == MODE_BUILD && job.layout_va != 0) {
			// The header's geometries must be the layout's.
			const uint geometries = LoadGuestU32(blas_va + 108);
			s_layout_geometries   = geometries == job.layout_count ? geometries : 0u;
			s_node_geometries     = blas_va + LoadGuestU32(blas_va + 40);
			s_node_first          = LoadGuestU32(blas_va + 124);
			// "PSR_BVHL", version 9, and the geometries of the build the layout describes: the
			// guest may have built another BLAS there since (the build waits for a preparation).
			s_layout_invalid = LoadGuestU32(blas_va) != 0x5f525350u || LoadGuestU32(blas_va + 4) != 0x4c485642u ||
			                           LoadGuestU32(blas_va + 252) != 9u || geometries != job.layout_count
			                       ? 1u
			                       : 0u;
		}
		if (IsBoxNode(root)) {
			const BoxNode root_box = LoadBoxNode(base, root);
			for (uint c = 0; c < 4; c++) {
				if (root_box.children[c] != kInvalidNode &&
				    all(lessThanEqual(root_box.lo[c], root_box.hi[c]))) {
					s_root_lo = min(s_root_lo, root_box.lo[c]);
					s_root_hi = max(s_root_hi, root_box.hi[c]);
				}
			}
		}
		// Box nodes never outnumber the node limit of the BVH descriptor, nor (with at least one
		// leaf or box child each) twice the leaves of a known BLAS.
		const uint limit = LoadGuestU32(blas_va + 88) + 1;
		s_queue_size = min(queue_size > 16 ? min(queue_size, limit) : limit, kMaxQueue);
		if (pc.mode == MODE_COUNT) {
			// The node limit of a BLAS can be huge: the BLASes counted together share a quarter
			// of the pool (the rest is for the builds and checks of this preparation), so that
			// one of them cannot take it all. One that does not fit its share reports an overflow
			// and is counted again later, with fewer of them missing.
			s_queue_size = min(s_queue_size, max(pc.pool_capacity / 4u / gl_NumWorkGroups.x, 64u));
		}
		s_queue_base = atomicAdd(state.pool_cursor, s_queue_size);
		if (s_queue_base + s_queue_size > pc.pool_capacity || s_queue_base + s_queue_size < s_queue_base) {
			s_queue_size = 0;
			s_overflow   = 4u;
			atomicAdd(state.pool_overflow, 1u);
		} else if (IsBoxNode(root)) {
			U32Ref(pc.pool + uint64_t(s_queue_base) * 4).v = root;
			s_tail = 1;
		}
	}
	barrier();
	if (lid == 0 && s_overflow == 0 && !IsBoxNode(root) && NodeType(root) < 4u &&
	    root != kInvalidNode) {
		if (pc.mode == MODE_VERIFY) {
			s_leaves = 1;
		} else {
			EmitLeaf(blas_va, base, root, job, vec3(1), vec3(0));
		}
	}
	const uint64_t queue          = pc.pool + uint64_t(s_queue_base) * 4;
	const uint     queue_capacity = s_queue_size;
	uint           depth          = 0;
	while (true) {
		const uint head = s_head;
		const uint tail = s_tail;
		if (head == tail || depth > 64) {
			break;
		}
		if (lid == 0) {
			s_next_tail = tail;
		}
		barrier();
		for (uint i = head + lid; i < tail; i += gl_WorkGroupSize.x) {
			const uint    node = U32Ref(queue + uint64_t(i) * 4).v;
			const BoxNode box  = LoadBoxNode(base, node);
			uint          hash = Mix(0x1234567u, node);
			for (uint c = 0; c < 4; c++) {
				const uint child = box.children[c];
				hash             = Mix(hash, child);
				if (child == kInvalidNode) {
					continue;
				}
				hash            = Mix(hash, floatBitsToUint(box.lo[c].x));
				hash            = Mix(hash, floatBitsToUint(box.lo[c].y));
				hash            = Mix(hash, floatBitsToUint(box.lo[c].z));
				hash            = Mix(hash, floatBitsToUint(box.hi[c].x));
				hash            = Mix(hash, floatBitsToUint(box.hi[c].y));
				hash            = Mix(hash, floatBitsToUint(box.hi[c].z));
				const uint type = NodeType(child);
				if (type == 4u || type == 5u) {
					const uint next = atomicAdd(s_next_tail, 1u);
					if (next < queue_capacity) {
						U32Ref(queue + uint64_t(next) * 4).v = child;
					} else {
						atomicOr(s_overflow, 1u);
					}
				} else if (type < 4u) {
					if (pc.mode == MODE_VERIFY) {
						atomicAdd(s_leaves, 1u);
					} else {
						EmitLeaf(blas_va, base, child, job, box.lo[c], box.hi[c]);
					}
				}
			}
			atomicAdd(s_signature, hash);
		}
		barrier();
		if (lid == 0) {
			s_head = tail;
			s_tail = min(s_next_tail, queue_capacity);
		}
		depth++;
		barrier();
	}
	if (depth > 64 && lid == 0) {
		s_overflow |= 2u;
	}
	barrier();
	const uint leaf_count = s_leaves;
	const uint opaque     = s_opaque;
	const uint alpha      = s_alpha;
	if (pc.mode == MODE_COUNT) {
		if (lid == 0) {
			MissingEntry missing = MissingEntry(pc.jobs + uint64_t(job_index) * kMissingStride);
			missing.leaf_count   = leaf_count;
			missing.box_count    = s_tail;
			missing.opaque_count = opaque;
			missing.alpha_count  = alpha;
			missing.node_limit   = LoadGuestU32(blas_va + 88);
			missing.flags        = s_overflow;
		}
		return;
	}
	SlotInfo info = SlotInfo(pc.slots + uint64_t(slot) * kSlotStride);
	if (pc.mode == MODE_BUILD && job.layout_va != 0) {
		// Every position is used (the host filled them with inactive triangles before the walk).
		if (lid == 0) {
			info.leaf_count = leaf_count;
			info.count0     = s_capacity0;
			info.count1     = s_capacity1;
			info.signature  = s_signature;
			job.mismatches  = s_mismatches;
			job.result      = (s_overflow << 1) | (s_mismatches != 0 ? 16u : 0u) | (s_layout_invalid << 5);
		}
		return;
	}
	if (pc.mode == MODE_BUILD) {
		// Inactive triangles (a NaN vertex) fill the rest of both geometries.
		const float nan = uintBitsToFloat(0x7fc00000u);
		for (uint i = opaque + lid; i < s_capacity0; i += gl_WorkGroupSize.x) {
			TriangleRef(job.vertices0 + uint64_t(i) * 36).v[0] = nan;
		}
		for (uint i = alpha + lid; i < s_capacity1; i += gl_WorkGroupSize.x) {
			TriangleRef(job.vertices1 + uint64_t(i) * 36).v[0] = nan;
		}
		if (lid == 0) {
			info.leaf_count = leaf_count;
			info.count0     = opaque;
			info.count1     = alpha;
			info.signature  = s_signature;
			const bool grow = opaque > s_capacity0 || alpha > s_capacity1;
			job.result      = (grow ? 1u : 0u) | (s_overflow << 1);
			if (grow) {
				// The host reads back the counts it must make room for.
				job.capacity0 = opaque;
				job.capacity1 = alpha;
			}
		}
		return;
	}
	// A walk without room in its queue found more boxes than the BLAS had: it changed.
	if (lid == 0 && (s_overflow & 4u) == 0 && (s_overflow == 0 || (s_overflow & 1u) != 0)) {
		if ((s_overflow & 1u) != 0 || info.signature != s_signature || info.leaf_count != leaf_count) {
			const uint index = atomicAdd(state.changed_count, 1u);
			if (index < pc.changed_capacity) {
				U32Ref(pc.changed + uint64_t(index) * 4).v = slot;
			}
			// Built again by the host; until then only reported once (a walk that overflowed saw
			// only part of the BLAS: it is reported until the build counts it).
			if (s_overflow == 0) {
				info.signature  = s_signature;
				info.leaf_count = leaf_count;
			}
		}
	}
}
